{%- if collection.filters != empty -%}
  {%- capture active_filters -%}
    {%- for filter in collection.filters -%}
      {%- for value in filter.active_values -%}
        <li><a data-collection-remove href="{{ value.url_to_remove | escape }}" aria-label="{{ 'collections.sidebar.text_remove_parameter' | t | escape }} {{ filter.label | escape }}: {{ value.label | escape }}">{{ filter.label | escape }}: {{ value.label | escape }} <span class="collection-native-remove-icon" aria-hidden="true">&times;</span></a></li>
      {%- endfor -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          {%- assign minimum = filter.min_value.value | default: 0 -%}
          {%- assign maximum = filter.max_value.value | default: filter.range_max -%}
          <li><a data-collection-remove href="{{ filter.url_to_remove | escape }}" aria-label="{{ 'collections.sidebar.text_remove_parameter' | t | escape }} {{ filter.label | escape }}: {{ minimum | money }} – {{ maximum | money }}">{{ filter.label | escape }}: {{ minimum | money }} – {{ maximum | money }} <span class="collection-native-remove-icon" aria-hidden="true">&times;</span></a></li>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {% if active_filters != blank %}
    <div class="collection-native-active">
      <ul>{{ active_filters }}</ul>
      {% render 'collection-native-filter-reset', collection: collection, collection_view: collection_view %}
    </div>
  {% endif %}

  <form class="collection-native-filters" action="{{ collection.url | escape }}" method="get">
    <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by | escape }}">
    {% if collection_view != blank %}
      <input type="hidden" name="view" value="{{ collection_view | escape }}">
    {% endif %}
    {% for filter in collection.filters %}
      {% assign category_style = false %}
      {% if filter.param_name == 'filter.p.t.category' or filter.param_name == 'filter.p.m.custom.familia_comercial' %}
        {% assign category_style = true %}
      {% endif %}
      <details class="collection-native-group" data-filter-key="{{ filter.param_name | escape }}" open>
        <summary>
          {{ filter.label | escape }}{% if filter.type == 'price_range' %} ({{ cart.currency.symbol | escape }}){% endif %}
        </summary>
        <fieldset aria-label="{{ filter.label | escape }}">
        {% case filter.type %}
          {% when 'boolean', 'list' %}
            {% if filter.values.size > 8 %}
              <input type="search" class="collection-native-search" data-filter-search hidden
                aria-label="{{ 'collections.native.search_values' | t: filter: filter.label | escape }}"
                placeholder="{{ 'collections.native.search_values' | t: filter: filter.label | escape }}">
              <p data-filter-no-match role="status" hidden>{{ 'collections.native.no_values' | t }}</p>
            {% endif %}
            <div class="collection-native-values">
            {% for value in filter.values %}
              {% assign swatch_image = value.swatch.image | default: value.image %}
              <label class="collection-native-value{% if category_style %} collection-native-value--category{% endif %}" data-filter-value="{{ value.label | escape }}">
                <input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}"
                  {% if value.active %}checked{% elsif value.count == 0 %}disabled{% endif %}>
                {% if value.image and filter.presentation == 'image' %}
                  {{ value.image | image_url: width: 64 | image_tag: alt: '', width: 32, class: 'collection-native-filter-image' }}
                {% elsif swatch_image %}
                  {{ swatch_image | image_url: width: 32 | image_tag: alt: '', width: 16, height: 16, class: 'collection-native-swatch' }}
                {% elsif value.swatch.color %}
                  <span class="collection-native-swatch" style="background-color: {{ value.swatch.color | escape }}" aria-hidden="true"></span>
                {% endif %}
                <span class="collection-native-value-label">{{ value.label | escape }}</span>
                <span class="collection-native-count">({{ value.count }})</span>
              </label>
            {% endfor %}
            </div>
          {% when 'price_range' %}
            {% assign range_max = filter.range_max | divided_by: 100.0 %}
            <div class="collection-native-price-group" data-price-group
              data-price-error="{{ 'collections.native.price_order' | t | escape }}">
            <div class="collection-native-price">
              <label>
                <span aria-hidden="true">{{ cart.currency.symbol | escape }}</span>
                <input type="number" data-price-min placeholder="0"
                  aria-label="{{ 'collections.native.from' | t | escape }} ({{ cart.currency.iso_code | escape }})" name="{{ filter.min_value.param_name | escape }}" min="0" step="any"
                  max="{{ range_max }}"
                  {% if filter.min_value.value != nil %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}>
              </label>
              <span class="collection-native-price-divider" aria-hidden="true">&ndash;</span>
              <label>
                <span aria-hidden="true">{{ cart.currency.symbol | escape }}</span>
                <input type="number" data-price-max placeholder="{{ range_max }}"
                  aria-label="{{ 'collections.native.to' | t | escape }} ({{ cart.currency.iso_code | escape }})" name="{{ filter.max_value.param_name | escape }}" min="0" step="any"
                  max="{{ range_max }}"
                  {% if filter.max_value.value != nil %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}>
              </label>
            </div>
            {% if range_max > 0 %}
              <div class="collection-native-range" data-price-range hidden>
                <div class="collection-native-range-track" aria-hidden="true"></div>
                <input type="range" data-range-min min="0" max="{{ range_max }}" step="any"
                  aria-label="{{ filter.label | escape }} — {{ 'collections.native.from' | t | escape }}">
                <input type="range" data-range-max min="0" max="{{ range_max }}" step="any"
                  aria-label="{{ filter.label | escape }} — {{ 'collections.native.to' | t | escape }}">
                <div class="collection-native-range-marks" aria-hidden="true">
                  {% for index in (0..4) %}
                    {% assign mark = range_max | times: index | divided_by: 4.0 %}
                    <span>{% if forloop.last %}{{ mark | round: 2 }}{% else %}{{ mark | round }}{% endif %}</span>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
            </div>
        {% endcase %}
        </fieldset>
      </details>
    {% endfor %}
  </form>
{%- endif -%}
